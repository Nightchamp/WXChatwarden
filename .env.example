# Copy to .env and fill in. Never commit .env.

# --- Model backend (any OpenAI-compatible chat completions API) ---
CW_LLM_BASE_URL=https://api.example.com/v1
CW_LLM_API_KEY=
CW_LLM_MODEL=your-model-name
# Optional per-lane overrides; each falls back to CW_LLM_MODEL.
CW_LLM_MODEL_FAST=
CW_LLM_MODEL_VISION=
CW_LLM_MODEL_AUDIO=

# --- Gateway ---
CW_GATEWAY_HOST=127.0.0.1
CW_GATEWAY_PORT=8643
CW_SESSION_TURNS=3

# --- Bot identity ---
# The account the bot speaks as (its own id in the message store).
CW_BOT_WXID=
CW_ACCOUNT_ID=
# Owner features (remote settings, owner-only commands) stay off until you
# set the owner's exact id here.
CW_OWNER_WXID=

# --- Message source: a directory of plain, readable SQLite files ---
CW_STORE_DIR=./store

# --- Message sink: console | jsonl | agent_wechat | package.module:Class ---
CW_SINK=console
CW_SINK_JSONL=/var/lib/chatwarden/outbox.jsonl

# --- Optional services that are not part of this repository ---
CW_DECISION_SHADOW=0

# --- Reply behaviour ---
# Rule layer in front of the follow-up / proactive judges (rules only ever
# say "no"): shadow = log only (default), active = skip the model on a rule
# hit, off = disabled. Log tag [v3.205-prefilter].
CW_PREFILTER=shadow
# Image recognition: send one short "still looking" notice if the model has
# not answered after this many seconds (0 = off). Log tag [v3.205-slow-ack].
CW_VISION_SLOW_ACK_SEC=20
# Group voice is transcribed off the group's worker thread so other members'
# messages keep flowing (0 = transcribe inline as before).
CW_VOICE_ASYNC=1
# Bot chat history (group_messages): newest rows kept per chat, total row
# ceiling, and maximum age in days. PER_CHAT=0 restores the legacy single
# global cap of 10000 rows (about three days across all groups).
CW_GROUP_MESSAGES_PER_CHAT=50000
CW_GROUP_MESSAGES_MAX_TOTAL=300000
CW_GROUP_MESSAGES_MAX_AGE_DAYS=30
# Private chats: when a message points back in time (之前/上次/还记得...),
# pull matching older raw lines back into the prompt (0 = off).
CW_PRIVATE_RECALL=1
